# WEBHOOK_TOKEN is generated locally during first deployment and stored only in .env.
HOST=0.0.0.0
PORT=8081
TIMEZONE=Asia/Shanghai
MAX_BODY_BYTES=10485760
QUEUE_MAX_SIZE=5000
BATCH_SIZE=200
BATCH_WAIT_MS=10
# DATA_DIR=/var/lib/scc_tt/data
# LOG_DIR=/var/log/scc_tt

# Incoming TCP packet metadata logging (requires tcpdump and root/CAP_NET_RAW)
NETWORK_DEBUG=1

# WAF proxy: third-party token is generated in local .env on deployment
# Configure the SCC API token and internal endpoint on the 8081 server.
WAF_TOKEN=
SCC_API_TOKEN=
SCC_WAF_URL=http://127.0.0.1:8000/api/v1/waf/requests
